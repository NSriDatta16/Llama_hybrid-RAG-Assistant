# Copy this file to backend/.env and fill in only the providers you use.
# Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# Optional: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Retrieval settings
INDEX_DIR=backend/index_wiki20k
HYBRID_ALPHA=0.6
